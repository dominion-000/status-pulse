{
  "name": "status-pulse",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP endpoint monitoring, incident communication and public status pages",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-prisma-generated.mjs",
    "copy:prisma": "node scripts/copy-prisma-generated.mjs",
    "build:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:validate": "prisma validate",
    "seed": "node dist/scripts/seed.js",
    "start:api": "node dist/src/main.js",
    "start:scheduler": "node dist/src/scheduler/main.js",
    "start:worker": "node dist/src/worker/main.js",
    "start:dispatcher": "node dist/src/dispatcher/main.js",
    "start:all": "node dist/scripts/launcher.js",
    "dev:api": "node --watch dist/src/main.js",
    "dev:scheduler": "node --watch dist/src/scheduler/main.js",
    "dev:worker": "node --watch dist/src/worker/main.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/client-runtime-utils": "7.10.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "pg": "^8.23.0",
    "redis": "^6.3.1",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^7.10.0",
    "supertest": "^7.3.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  }
}
