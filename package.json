{
  "name": "status-pulse",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP endpoint monitoring, incident communication and public status pages",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start:api": "node dist/main.js",
    "start:scheduler": "node dist/scheduler/main.js",
    "start:worker": "node dist/worker/main.js",
    "start:dispatcher": "node dist/dispatcher/main.js",
    "dev:api": "node --watch dist/main.js",
    "dev:scheduler": "node --watch dist/scheduler/main.js",
    "dev:worker": "node --watch dist/worker/main.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "express": "^5.2.1",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.4",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  }
}
