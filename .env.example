# PostgreSQL connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/status_pulse

# 32-byte key, base64-encoded (generate: openssl rand -base64 32)
CREDENTIALS_ENC_KEY=

# JWT signing secret for access tokens (min 32 chars)
JWT_SECRET=

# Access token lifetime in seconds (default 28800 = 8 hours)
ACCESS_TOKEN_TTL_SECONDS=28800

# Refresh token lifetime in days (default 30)
REFRESH_TOKEN_TTL_DAYS=30

# Worker lease duration in seconds
WORKER_LEASE_SECONDS=60

# Max claim attempts before a job is abandoned
WORKER_MAX_ATTEMPTS=5

# Port for the API process
PORT=3000

# A separate PostgreSQL database for tests. The tests create and drop their own schemas in it: never use the real database.
DATABASE_URL_TEST=

# Dispatcher: lease length and max automatic attempts before a manual retry is required
DISPATCHER_LEASE_SECONDS=30
DISPATCHER_MAX_ATTEMPTS=6

# Number of proxies in front of the API (Render = 1). Used for rate-limit client IP.
TRUST_PROXY_HOPS=1

# Resend.
RESEND_API_KEY=
MAIL_FROM=Status Pulse <onboarding@resend.dev>

# Paystack.
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=NGN

# Ops only: set to 1 to disable rate limits temporarily (login/register/subscribe).
# RATE_LIMIT_DISABLED=

# Comma-separated browser origins allowed to call the API
CORS_ORIGIN=
# Redis (public status cache, shared across API instances). Optional locally — falls back to memory.
REDIS_URL=
# Public status cache TTL in ms (converted to seconds for Redis EX). Default 5000.
PUBLIC_STATUS_CACHE_MS=5000
# Winston level: error | warn | info | http | verbose | debug
LOG_LEVEL=info
