# PostgreSQL connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/status_pulse

# 32-byte key, base64-encoded (generate: openssl rand -base64 32)
CREDENTIALS_ENC_KEY=

# JWT signing secret for access tokens (min 32 chars)
JWT_SECRET=

# Access token lifetime in seconds (default 900 = 15 minutes)
ACCESS_TOKEN_TTL_SECONDS=28800

# Refresh token lifetime in days (default 30)
REFRESH_TOKEN_TTL_DAYS=30

# Worker lease duration in seconds
WORKER_LEASE_SECONDS=60

# Max claim attempts before a job is abandoned
WORKER_MAX_ATTEMPTS=5

# Port for the API process
PORT=3000

# A separate PostgreSQL database for tests. The tests create and drop their own schemas in it: never use the real database.
DATABASE_URL_TEST=

# Dispatcher: lease length and max automatic attempts before a manual retry is required
DISPATCHER_LEASE_SECONDS=30
DISPATCHER_MAX_ATTEMPTS=6

# Set to 1 to make every simulated send fail. Addresses on fail.example always fail.
MAIL_FAIL_ALL=0

# 1 switches rate limiting off.
RATE_LIMIT_DISABLED=

# Number of proxies in front of the API.
TRUST_PROXY_HOPS=0

# Set to 1 to make every simulated payment fail.
PAYMENT_FAIL_ALL=0

# EXPOSE_VERIFICATION_TOKEN=1
