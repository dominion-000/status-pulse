# PostgreSQL connection (Supabase session pooler or local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/status_pulse

# 32-byte key, base64-encoded (generate: openssl rand -base64 32)
CREDENTIALS_ENC_KEY=

# JWT signing secret for access tokens (min 32 chars)
JWT_SECRET=

# Access token lifetime in seconds (default 900 = 15 minutes)
ACCESS_TOKEN_TTL_SECONDS=900

# Refresh token lifetime in days (default 30)
REFRESH_TOKEN_TTL_DAYS=30

# Worker lease duration in seconds
WORKER_LEASE_SECONDS=60

# Max claim attempts before a job is abandoned
WORKER_MAX_ATTEMPTS=5

# Port for the API process
PORT=3000
