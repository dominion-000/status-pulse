<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>Status Pulse</title>
  <link rel="stylesheet" href="/ui/assets/styles.css" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="wrap">
    <header class="app-header">
      <a class="brand" href="<%= typeof brandHref !== 'undefined' ? brandHref : '/' %>">
        <svg class="mark" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="7" cy="14" r="2.2" fill="currentColor" opacity="0.55"/>
          <circle cx="12" cy="9" r="2.8" fill="currentColor" opacity="0.8"/>
          <circle cx="17" cy="11" r="3.4" fill="currentColor"/>
        </svg>
        Status Pulse
      </a>
      <nav>
        <% if (typeof nav !== 'undefined' && nav) { %>
          <% nav.forEach(function (item) { %>
            <% if (item.href === '/app/logout') { %>
              <form method="post" action="/app/logout" style="display:inline;margin:0">
                <button type="submit" class="secondary" style="padding:0.25rem 0.5rem"><%= item.label %></button>
              </form>
            <% } else { %>
              <a href="<%= item.href %>" class="<%= item.active ? 'active' : '' %>"><%= item.label %></a>
            <% } %>
          <% }) %>
        <% } %>
        <% if (typeof user !== 'undefined' && user && user.email) { %>
          <span class="nav-user"><%= user.email %></span>
        <% } %>
      </nav>
    </header>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="flash flash-error"><%= error %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="flash flash-ok"><%= success %></div>
    <% } %>

    <main id="main">
      <%- body %>
    </main>

    <footer class="app-footer">Status Pulse · monitoring</footer>
  </div>
</body>
</html>
