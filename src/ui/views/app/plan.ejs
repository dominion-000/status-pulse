<div class="page-head">
  <div>
    <p class="crumb"><a href="/app/projects/<%= project.id %>"><%= project.name %></a></p>
    <h1>Plan</h1>
  </div>
  <nav class="tabs">
    <a href="/app/projects/<%= project.id %>">Overview</a>
    <a href="/app/projects/<%= project.id %>/alerts">Alerts</a>
    <a class="active" href="/app/projects/<%= project.id %>/plan">Plan</a>
  </nav>
</div>

<div class="card">
  <p>Current plan: <strong><%= current.name %></strong></p>
  <p class="meta"><%= current.maxServices %> services · <%= current.maxMembers %> members · <%= current.priceCents %>¢</p>
</div>

<% if (typeof canUpgrade !== 'undefined' && canUpgrade) { %>
<h2>Change plan</h2>
<form method="post" action="/app/projects/<%= project.id %>/plan" class="card form-card">
  <% if (typeof formError !== 'undefined' && formError) { %>
    <div class="flash flash-error"><%= formError %></div>
  <% } %>
  <label for="planName">Plan</label>
  <select id="planName" name="planName">
    <% plans.forEach(function (p) { %>
      <option value="<%= p.name %>" <%= p.name === current.name ? 'selected' : '' %>>
        <%= p.name %> — <%= p.maxServices %> services, <%= p.priceCents %>¢
      </option>
    <% }) %>
  </select>
  <input type="hidden" name="idempotencyKey" value="<%= defaultKey %>" />
  <button type="submit">Save plan</button>
</form>
<% } else { %>
  <p class="muted">Only owners can change the plan.</p>
<% } %>
