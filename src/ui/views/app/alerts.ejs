<h1>Alerts</h1>
<p class="muted"><%= project.name %></p>
<p><a href="/app/projects/<%= project.id %>">← Project</a></p>

<% if (!alerts.length) { %>
  <div class="card"><p class="muted">No alerts.</p></div>
<% } %>

<% alerts.forEach(function (a) { %>
  <div class="card">
    <div class="row">
      <div>
        <strong><%= a.state %></strong>
        <span class="meta"> · <%= a.createdAt %></span>
      </div>
      <% if (a.acknowledgement) { %>
        <span class="badge badge-operational">acked</span>
      <% } else { %>
        <form method="post" action="/app/projects/<%= project.id %>/alerts/<%= a.id %>/acknowledge" style="margin:0">
          <button type="submit" class="secondary">Acknowledge</button>
        </form>
      <% } %>
    </div>
    <% if (a.messages && a.messages.length) { %>
      <table>
        <thead><tr><th>Recipient</th><th>Attempts</th><th>Delivered</th><th></th></tr></thead>
        <tbody>
          <% a.messages.forEach(function (m) { %>
            <tr>
              <td><%= m.recipientEmail %></td>
              <td><%= m.attempts %></td>
              <td class="meta"><%= m.deliveredAt || m.lastError || 'pending' %></td>
              <td>
                <% if (!m.deliveredAt) { %>
                  <form method="post" action="/app/projects/<%= project.id %>/alerts/<%= a.id %>/retry" style="margin:0">
                    <button type="submit" class="secondary">Retry</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
<% }) %>
