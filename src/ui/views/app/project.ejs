<div class="page-head">
  <div>
    <p class="crumb"><a href="/app/projects">Projects</a></p>
    <h1><%= project.name %></h1>
    <p class="meta">
      <code><%= project.slug %></code>
      · plan <strong><%= plan.name %></strong>
      · <a href="/status/<%= project.slug %>" target="_blank" rel="noopener">Public status ↗</a>
    </p>
  </div>
  <nav class="tabs">
    <a class="<%= typeof tab !== 'undefined' && tab === 'overview' ? 'active' : '' %>" href="/app/projects/<%= project.id %>">Overview</a>
    <a class="<%= typeof tab !== 'undefined' && tab === 'alerts' ? 'active' : '' %>" href="/app/projects/<%= project.id %>/alerts">Alerts</a>
    <a class="<%= typeof tab !== 'undefined' && tab === 'plan' ? 'active' : '' %>" href="/app/projects/<%= project.id %>/plan">Plan</a>
  </nav>
</div>

<section>
  <div class="section-head">
    <h2>Services</h2>
  </div>
  <% if (!services.length) { %>
    <div class="card empty"><p class="muted">No services yet.</p></div>
  <% } else { %>
    <div class="list">
      <% services.forEach(function (s) { %>
        <div class="card">
          <div class="row">
            <div>
              <strong><%= s.name %></strong>
              <span class="meta">
                <% if (s.isPublic) { %>public<% } else { %>private<% } %>
                <% if (!s.enabled) { %> · disabled<% } %>
              </span>
            </div>
            <span class="badge badge-<%= String(s.currentStatus).toLowerCase() %>"><%= s.currentStatus %></span>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>

<% if (typeof canManage !== 'undefined' && canManage) { %>
<section>
  <h2>Add service</h2>
  <form method="post" action="/app/projects/<%= project.id %>/services" class="card form-card">
    <% if (typeof formError !== 'undefined' && formError) { %>
      <div class="flash flash-error"><%= formError %></div>
    <% } %>
    <label for="svc-name">Name</label>
    <input id="svc-name" name="name" type="text" required maxlength="120" placeholder="API" />

    <label for="svc-url">URL</label>
    <input id="svc-url" name="url" type="url" required maxlength="2048" placeholder="https://httpbin.org/status/200" />

    <div class="form-row">
      <div>
        <label for="interval">Interval (seconds)</label>
        <input id="interval" name="intervalSeconds" type="number" min="30" value="60" required />
      </div>
      <div>
        <label for="timeout">Timeout (seconds)</label>
        <input id="timeout" name="timeoutSeconds" type="number" min="1" value="10" required />
      </div>
    </div>

    <label class="check">
      <input type="checkbox" name="isPublic" value="true" checked />
      Public on status page
    </label>

    <button type="submit">Add service</button>
  </form>
</section>
<% } %>

<section>
  <div class="section-head">
    <h2>Active incidents</h2>
  </div>
  <% if (!incidents.length) { %>
    <div class="card empty"><p class="muted">None open.</p></div>
  <% } else { %>
    <div class="list">
      <% incidents.forEach(function (i) { %>
        <div class="card">
          <div class="row">
            <div>
              <strong><%= i.title %></strong>
              <span class="meta"> · <%= i.status %></span>
            </div>
            <span class="meta"><%= i.createdAt %></span>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>
