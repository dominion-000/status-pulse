<h1>Subscribe</h1>
<p class="muted"><%= project.name %> · public services only</p>

<% if (typeof done !== 'undefined' && done) { %>
  <div class="flash flash-ok">
    Check your email for a verification message.
    <% if (typeof verificationToken !== 'undefined' && verificationToken) { %>
      <p class="meta">Demo token (also in outbox): <code><%= verificationToken %></code></p>
      <p><a href="/status/<%= project.slug %>/verify">Enter token</a></p>
    <% } %>
  </div>
<% } else { %>
  <form method="post" action="/status/<%= project.slug %>/subscribe" class="card">
    <label for="email">Email</label>
    <input id="email" name="email" type="email" required />

    <p class="muted">Services</p>
    <div class="checks">
      <% services.forEach(function (s) { %>
        <label>
          <input type="checkbox" name="serviceIds" value="<%= s.id %>" checked />
          <%= s.name %>
        </label>
      <% }) %>
    </div>
    <% if (!services.length) { %>
      <p class="muted">No public services to subscribe to.</p>
    <% } else { %>
      <button type="submit">Subscribe</button>
    <% } %>
  </form>
<% } %>

<p><a href="/status/<%= project.slug %>">← Status page</a></p>
