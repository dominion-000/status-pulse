<h1><%= project.name %></h1>
<p class="muted">Public status · <code><%= project.slug %></code></p>

<% if (!services.length) { %>
  <div class="card"><p class="muted">No public services.</p></div>
<% } %>

<% services.forEach(function (s) { %>
  <div class="card">
    <div class="row">
      <strong><%= s.name %></strong>
      <span class="badge badge-<%= s.currentStatus.toLowerCase() %>"><%= s.currentStatus %></span>
    </div>
    <p class="meta">
      Since <%= s.statusSince %>
      <% if (s.lastResultAt) { %> · last check <%= s.lastResultAt %><% } %>
    </p>

    <% if (s.activeIncident) { %>
      <h2>Active incident</h2>
      <p><strong><%= s.activeIncident.title %></strong> · <%= s.activeIncident.status %></p>
      <% if (s.activeIncident.updates && s.activeIncident.updates.length) { %>
        <ul class="stack">
          <% s.activeIncident.updates.forEach(function (u) { %>
            <li class="meta"><%= u.createdAt %> — <%= u.message %></li>
          <% }) %>
        </ul>
      <% } %>
    <% } %>

    <% if (s.recentHistory && s.recentHistory.length) { %>
      <h2>Recent history</h2>
      <table>
        <thead><tr><th>Status</th><th>Started</th></tr></thead>
        <tbody>
          <% s.recentHistory.forEach(function (h) { %>
            <tr>
              <td><span class="badge badge-<%= h.status.toLowerCase() %>"><%= h.status %></span></td>
              <td class="meta"><%= h.startedAt %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
<% }) %>

<p><a href="/status/<%= project.slug %>/subscribe">Subscribe to updates</a></p>
