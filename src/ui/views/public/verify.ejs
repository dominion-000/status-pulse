<h1>Verify subscription</h1>

<% if (typeof verified !== 'undefined' && verified) { %>
  <div class="flash flash-ok">Subscription verified for <%= email %>.</div>
<% } else { %>
  <form method="post" action="/status/verify" class="card" style="max-width:28rem">
    <label for="token">Verification token</label>
    <input id="token" name="token" type="text" required minlength="16" placeholder="paste token from email" />
    <button type="submit">Verify</button>
  </form>
<% } %>
