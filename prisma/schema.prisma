generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String         @unique
  passwordHash String         @map("password_hash")
  name         String?
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  memberships    Membership[]
  refreshTokens  RefreshToken[]
  auditEntries   AuditLog[]     @relation("AuditActor")
  overridesSet       StatusOverride[] @relation("OverrideActor")
  overridesEnded     StatusOverride[] @relation("OverrideEnder")
  incidentsOpened    Incident[]       @relation("IncidentOpener")
  incidentsResolved  Incident[]       @relation("IncidentResolver")
  incidentUpdates    IncidentUpdate[] @relation("IncidentUpdateActor")
  acknowledgements   Acknowledgement[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Project {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String    @unique
  planId    String    @map("plan_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  plan             Plan              @relation(fields: [planId], references: [id])
  memberships      Membership[]
  services         Service[]
  auditEntries     AuditLog[]
  incidents        Incident[]
  alerts           Alert[]
  outbox           OutboxMessage[]
  subscribers      Subscriber[]
  paymentAttempts  PaymentAttempt[]

  @@map("projects")
}

model Membership {
  projectId String   @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   // Owner | Responder | Viewer — CHECK in migration
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("memberships")
}

model Service {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId          String    @map("project_id") @db.Uuid
  name               String
  url                String
  method             String    @default("GET")
  intervalSeconds    Int       @map("interval_seconds")
  timeoutSeconds     Int       @map("timeout_seconds")
  expectedStatusCodes Int[]    @default([200]) @map("expected_status_codes")
  expectedBodyText   String?   @map("expected_body_text")
  isPublic           Boolean   @default(false) @map("is_public")
  enabled            Boolean   @default(true)
  credentialsEnc     Bytes?    @map("credentials_enc")
  failThreshold      Int       @default(3) @map("fail_threshold")
  recoveryThreshold  Int       @default(2) @map("recovery_threshold")
  slowThreshold      Int       @default(3) @map("slow_threshold")
  degradedMs         Int?      @map("degraded_ms")
  currentStatus      String    @default("Unknown") @map("current_status")
  statusSince        DateTime  @default(now()) @map("status_since") @db.Timestamptz
  computedStatus     String    @default("Unknown") @map("computed_status")
  computedSince      DateTime  @default(now()) @map("computed_since") @db.Timestamptz
  lastResultAt       DateTime? @map("last_result_at") @db.Timestamptz
  version            Int       @default(1)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  project         Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  configVersions  ServiceConfigVersion[]
  checkJobs       CheckJob[]
  statusHistory   ServiceStatusHistory[]
  overrides       StatusOverride[]
  incidents       Incident[]
  alerts             Alert[]
  subscriberServices SubscriberService[]

  @@index([projectId])
  @@index([enabled, deletedAt])
  @@map("services")
}

model ServiceConfigVersion {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId   String   @map("service_id") @db.Uuid
  version     Int
  snapshot    Json
  actorUserId String?  @map("actor_user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, version])
  @@map("service_config_versions")
}

model CheckJob {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId    String    @map("service_id") @db.Uuid
  scheduledFor DateTime  @map("scheduled_for") @db.Timestamptz
  status       String    @default("queued") // queued | leased | done | skipped
  leaseUntil   DateTime? @map("lease_until") @db.Timestamptz
  attempts     Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  service Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  result  CheckResult?

  @@unique([serviceId, scheduledFor])
  @@index([status, scheduledFor])
  @@map("check_jobs")
}

model CheckResult {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId         String   @unique @map("job_id") @db.Uuid
  serviceId     String   @map("service_id") @db.Uuid
  statusCode    Int?     @map("status_code")
  latencyMs     Int?     @map("latency_ms")
  passed        Boolean
  failureReason String?  @map("failure_reason")
  configVersion Int      @map("config_version")
  checkedAt     DateTime @map("checked_at") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  job CheckJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  statusChanges ServiceStatusHistory[]

  @@index([serviceId, checkedAt])
  @@map("check_results")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId  String?  @map("project_id") @db.Uuid
  actorUserId String? @map("actor_user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actor   User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("audit_log")
}

model SchedulerFailure {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message   String
  details   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("scheduler_failures")
}

// Week 3. The partial unique indexes (one active override and one active incident per service) and the CHECK
// constraints live in the migration SQL, because Prisma cannot express them.

model ServiceStatusHistory {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId        String   @map("service_id") @db.Uuid
  status           String
  computedStatus   String   @map("computed_status")
  source           String
  causedByResultId String?  @map("caused_by_result_id") @db.Uuid
  startedAt        DateTime @default(now()) @map("started_at") @db.Timestamptz

  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  causedByResult CheckResult? @relation(fields: [causedByResultId], references: [id], onDelete: SetNull)

  @@index([serviceId, startedAt])
  @@map("service_status_history")
}

model StatusOverride {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId     String    @map("service_id") @db.Uuid
  status        String
  reason        String
  actorUserId   String    @map("actor_user_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz
  endedAt       DateTime? @map("ended_at") @db.Timestamptz
  endedByUserId String?   @map("ended_by_user_id") @db.Uuid
  endReason     String?   @map("end_reason")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  actor   User    @relation("OverrideActor", fields: [actorUserId], references: [id])
  endedBy User?   @relation("OverrideEnder", fields: [endedByUserId], references: [id])

  @@map("status_overrides")
}

model Incident {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId        String    @map("project_id") @db.Uuid
  serviceId        String    @map("service_id") @db.Uuid
  title            String
  status           String    @default("Investigating")
  origin           String
  isPublic         Boolean   @default(false) @map("is_public")
  openedByUserId   String?   @map("opened_by_user_id") @db.Uuid
  resolvedByUserId String?   @map("resolved_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service    Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  openedBy   User?            @relation("IncidentOpener", fields: [openedByUserId], references: [id])
  resolvedBy User?            @relation("IncidentResolver", fields: [resolvedByUserId], references: [id])
  updates    IncidentUpdate[]
  alerts     Alert[]

  @@index([projectId, createdAt])
  @@index([serviceId, createdAt])
  @@map("incidents")
}

model IncidentUpdate {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidentId  String   @map("incident_id") @db.Uuid
  status      String
  message     String
  isPublic    Boolean  @default(false) @map("is_public")
  actorUserId String?  @map("actor_user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actor    User?    @relation("IncidentUpdateActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
  @@map("incident_updates")
}

// Week 4. Alerts, acknowledgements and the outbox. The CHECK constraints live in the migration SQL.

model Alert {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  serviceId  String   @map("service_id") @db.Uuid
  incidentId String   @map("incident_id") @db.Uuid
  state      String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service         Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  incident        Incident         @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  acknowledgement Acknowledgement?
  messages        OutboxMessage[]

  @@unique([serviceId, incidentId, state], map: "alerts_one_per_problem")
  @@index([projectId, createdAt])
  @@index([incidentId])
  @@map("alerts")
}

model Acknowledgement {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  alertId     String   @unique @map("alert_id") @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  actor User  @relation(fields: [actorUserId], references: [id])

  @@map("acknowledgements")
}

model OutboxMessage {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId      String    @map("project_id") @db.Uuid
  kind           String
  alertId        String?   @map("alert_id") @db.Uuid
  recipientEmail String    @map("recipient_email")
  subject        String
  body           String
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz
  leaseUntil     DateTime? @map("lease_until") @db.Timestamptz
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  alert   Alert?  @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@unique([alertId, recipientEmail], map: "outbox_messages_one_per_recipient")
  @@index([alertId])
  @@map("outbox_messages")
}

model Plan {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @unique
  maxServices  Int      @map("max_services")
  maxMembers   Int      @map("max_members")
  priceCents   Int      @default(0) @map("price_cents")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  projects         Project[]
  paymentAttempts  PaymentAttempt[]

  @@map("plans")
}

model Subscriber {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId              String    @map("project_id") @db.Uuid
  email                  String
  verifiedAt             DateTime? @map("verified_at") @db.Timestamptz
  verificationTokenHash  String?   @map("verification_token_hash")
  verificationExpiresAt  DateTime? @map("verification_expires_at") @db.Timestamptz
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz

  project  Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  services SubscriberService[]

  @@unique([projectId, email], map: "subscribers_one_per_project")
  @@index([projectId])
  @@map("subscribers")
}

model SubscriberService {
  subscriberId String   @map("subscriber_id") @db.Uuid
  serviceId    String   @map("service_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  service    Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([subscriberId, serviceId])
  @@index([serviceId])
  @@map("subscriber_services")
}

model PaymentAttempt {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  planId         String   @map("plan_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key")
  status         String
  amountCents    Int      @map("amount_cents")
  errorMessage   String?  @map("error_message")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id])

  @@unique([projectId, idempotencyKey], map: "payment_attempts_one_key")
  @@index([projectId, createdAt])
  @@map("payment_attempts")
}
